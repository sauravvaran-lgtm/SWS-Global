# Public URL of the deployed site (no trailing slash). Used for canonical URLs, sitemap and social cards.
NEXT_PUBLIC_SITE_URL=https://swsglobal.co.in

# Web3Forms access key for the contact form (get a free key at https://web3forms.com,
# sent to the inbox that should receive inquiries). Public key — safe to expose.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
